# ==============================================================================
# ESP8266 Permission Portal — Environment Configuration
# ==============================================================================
# IMPORTANT: DO NOT commit actual secrets or your production .env to git.
# Copy this file to .env.local for local testing, or add to Vercel Project Settings.

# ------------------------------------------------------------------------------
# 1. Administrator Authentication
# ------------------------------------------------------------------------------
# Username for admin login (default if unset: admin)
ADMIN_USERNAME=admin

# Bcrypt hash of administrator password.
# Generate a new hash using: node scripts/hash-password.js "YourStrongPassword"
# Default fallback in development corresponds to password: "admin123"
ADMIN_PASSWORD_HASH=$2a$10$1jYJGNoxoMIN9z7Lm/axR.IwJwCkI6EDD/Ay.GPM6XzpjpKmqQYX2

# ------------------------------------------------------------------------------
# 2. Session Security
# ------------------------------------------------------------------------------
# High-entropy secret key for HMAC-SHA256 session signature verification (min 32 chars).
SESSION_SECRET=replace-with-a-cryptographically-secure-random-string-min-32-chars

# ------------------------------------------------------------------------------
# 3. Firebase Realtime Database (WebRTC Signaling)
# ------------------------------------------------------------------------------
# Used ONLY for signaling metadata (SDP offer/answer, ICE candidates, session state).
# Media streams (video/audio) are NEVER stored in Firebase.
#
# URL of your Firebase Realtime Database (e.g., https://my-project-default-rtdb.firebaseio.com)
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Firebase Client Configuration (Optional: exposed to frontend for direct RTDB listeners)
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID=1:1234567890:web:abcdef

# Optional server-side secret / database secret (for backend REST sync without rule restrictions)
FIREBASE_AUTH_SECRET=

# ------------------------------------------------------------------------------
# 4. WebRTC STUN / TURN Server Configuration
# ------------------------------------------------------------------------------
# Public STUN servers (e.g. Google's stun:stun.l.google.com:19302) are used by default.
# For cross-network NAT traversal (especially cellular mobile networks or corporate firewalls),
# configure a TURN relay server (e.g. from Metered.ca, Twilio, Xirsys, or Coturn).
TURN_SERVER_URL=turn:turn.example.com:3478
TURN_USERNAME=my-turn-username
TURN_PASSWORD=my-turn-password
